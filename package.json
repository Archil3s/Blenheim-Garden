{
  "name": "blenheim-garden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "node scripts/patch-opennext-env.cjs",
    "clean:opennext": "node -e \"require('fs').rmSync('.open-next',{recursive:true,force:true})\"",
    "build:cloudflare": "npm run clean:opennext && opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "preview": "npm run clean:opennext && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run clean:opennext && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply blenheim-garden --local",
    "db:migrate:remote": "wrangler d1 migrations apply blenheim-garden --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "typescript": "^5.9.0",
    "wrangler": "4.124.0"
  }
}
